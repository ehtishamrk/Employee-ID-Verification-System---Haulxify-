rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admin allowlist: create this document manually in Firebase Console:
    // admins/{THE_ADMIN_UID}
    match /admins/{uid} {
      allow read: if isAdmin() && request.auth.uid == uid;
      allow write: if false;
    }

    match /cards/{token} {
      // PUBLIC VERIFICATION:
      // - exact document lookup only; collection listing is never allowed
      // - token must be high entropy
      // - card must be active
      // - expiry must be current
      allow get: if isAdmin()
                 || (token.matches('^[A-Za-z0-9_-]{40,50}$')
                     && resource.data.status == 'active'
                     && resource.data.expiryAt >= request.time);

      // Public collection discovery is disabled; only admins may list cards.
      allow list: if isAdmin();

      // Only authorized admins can create/update/delete card records.
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
